{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "System": "Debug"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "logs\\KeyManager.log",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} <{ThreadId}> [{TraceId}] [{Level}] [{SourceContext}] [{EventId}] {Message}{NewLine}{Exception}",
                    "rollOnFileSizeLimit": true,
                    "fileSizeLimitBytes": 4194304,
                    "retainedFileCountLimit": 15,
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "AllowedHosts": "*"
}
