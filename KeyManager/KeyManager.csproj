<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b991059a-53ac-4e98-94a5-f48ddc2defb4</UserSecretsId>
  </PropertyGroup>
	
  <ItemGroup>
