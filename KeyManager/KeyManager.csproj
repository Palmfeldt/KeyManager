    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.1.5" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyManager.Application\KeyManager.Application.csproj" />
    <ProjectReference Include="..\KeyManager.Domain\KeyManager.Domain.csproj" />
    <ProjectReference Include="..\KeyManager.Persistence\KeyManager.Persistence.csproj" />
  </ItemGroup>

	<ItemGroup>
		<!-- This makes Program.cs available to the test project. -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
